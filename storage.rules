rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {

    // Único administrador: la cuenta de Google del club.
    function isAdmin() {
      return request.auth != null && request.auth.token.email == 'agarciah10@gmail.com';
    }

    // Solo imágenes rasterizadas (nada de SVG/HTML/ejecutables) y de menos de 5 MB.
    function isRasterImage() {
      return request.resource.contentType.matches('image/(png|jpeg|webp|gif)');
    }
    function isValidSize() {
      return request.resource.size < 5 * 1024 * 1024;
    }

    match /{allPaths=**} {
      // Las imágenes de la web son públicas.
      allow read: if true;
      // Subir o reemplazar: solo el admin y solo imágenes válidas.
      allow create, update: if isAdmin() && isRasterImage() && isValidSize();
      // Borrar: solo el admin (p. ej. al eliminar a una persona se retira también su foto).
      allow delete: if isAdmin();
    }
  }
}
