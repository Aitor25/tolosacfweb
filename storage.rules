rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    
    // Función auxiliar para validar que el archivo es una imagen rasterizada
    function isRasterImage() {
      return request.resource.contentType.matches('image/(png|jpeg|webp|gif)');
    }
    
    // Función auxiliar para validar el tamaño (ej. max 5MB)
    function isValidSize() {
      return request.resource.size < 5 * 1024 * 1024;
    }

    match /news/{imageId} {
      allow read: if true;
      allow write: if request.auth != null && request.auth.token.admin == true && isRasterImage() && isValidSize();
    }
    
    match /{allPaths=**} {
      allow read: if true;
      allow write: if request.auth != null && request.auth.token.admin == true && isRasterImage() && isValidSize();
    }
  }
}
